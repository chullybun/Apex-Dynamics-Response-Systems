<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--Disable warning about multiple package sources-->
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>

  <!-- CoreEx packages. -->
  <ItemGroup>
    <PackageVersion Include="CoreEx" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.AspNetCore" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.AspNetCore.NSwag" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Azure.Messaging.ServiceBus" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Caching.FusionCache" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Data" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Database" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Database.Postgres" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.DomainDriven" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.EntityFrameworkCore" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Events" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.RefData" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.Validation" Version="4.0.0-preview-2" />
  </ItemGroup>

  <!-- Aspire client integration packages. -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="13.4.6" />
    <PackageVersion Include="Aspire.Azure.Npgsql" Version="13.4.6" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.4.6" />
  </ItemGroup>

  <!-- OpenTelemetry packages. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
  </ItemGroup>

  <!-- FusionCache support packages. -->
  <ItemGroup>
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.6.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.6.0" />
  </ItemGroup>

  <!-- Tool/Test packages. -->
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="CoreEx.CodeGen" Version="4.0.0-preview-2" />
    <PackageVersion Include="CoreEx.UnitTesting" Version="4.0.0-preview-2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="DbEx.Postgres" Version="3.1.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.9.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="UnitTestEx.NUnit" Version="5.11.0" />
  </ItemGroup>
</Project>